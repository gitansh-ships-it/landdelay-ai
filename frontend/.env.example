# ==============================================================================
# LandDelay AI - Frontend Environment Variables (.env.example)
# ==============================================================================

# Backend API Base URL (must include /api suffix)
# Leave EMPTY or OMIT for local development (uses Vite dev server proxy to localhost:8000)
# In production on Vercel, set this to your deployed Render web service URL:
# Example: https://landdelay-api.onrender.com/api
VITE_API_BASE_URL=
