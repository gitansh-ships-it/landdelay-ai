# ==============================================================================
# LandDelay AI - Environment Variables Reference (.env.example)
# Copy this file to .env or configure these variables in your hosting provider.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Render / Server)
# ------------------------------------------------------------------------------
# Environment mode: 'development' or 'production'
ENVIRONMENT=production

# Network port and host binding
# On Render, $PORT is injected automatically by the platform runtime.
PORT=8000
HOST=0.0.0.0

# Database Connection URL:
# 1. PostgreSQL (Recommended for Render):
#    DATABASE_URL=postgresql://user:password@host.render.com/landdelay
#    Note: Render provides 'postgres://', which LandDelay AI automatically normalizes to 'postgresql://'.
# 2. SQLite Persistent Disk on Render (mount at /var/data):
#    DATABASE_URL=sqlite:////var/data/landdelay.db
# 3. Local SQLite development (default):
#    DATABASE_URL=sqlite:///./landdelay.db
DATABASE_URL=sqlite:///./landdelay.db

# Permitted CORS Origins (comma-separated list of origins)
# In production, set this to your exact Vercel frontend URL:
# Example: CORS_ORIGINS=https://landdelay-ai.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Administrative Secret Key for destructive operations (/api/demo/reset, /api/demo/seed)
# Required in 'X-Admin-Key' request header.
# Generate a strong 32+ character random string for production.
ADMIN_RESET_KEY=landdelay-admin-secret-2026

# Automatic Demo Data Seeding on cold start:
# - 'true': Seeds 250 deterministic cases only if database is completely empty. Preserves existing data across restarts.
# - 'false': Never seeds automatically; database must be populated via CSV upload or /api/demo/seed.
AUTO_SEED_DEMO_DATA=true

# ------------------------------------------------------------------------------
# Frontend Configuration (Vercel / Vite)
# ------------------------------------------------------------------------------
# Deployed Backend API Base URL (must include /api suffix)
# For local development with Vite dev server proxy, leave empty or unset.
# For production deployment on Vercel:
# VITE_API_BASE_URL=https://landdelay-api.onrender.com/api
VITE_API_BASE_URL=
