# ==============================================================================
# LandDelay AI - Backend Environment Variables (.env.example)
# ==============================================================================

ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Database URL:
# PostgreSQL (Production): postgresql://user:password@host.render.com:5432/landdelay
# SQLite (Local Dev): sqlite:///./landdelay.db
# SQLite (Render Disk): sqlite:////var/data/landdelay.db
DATABASE_URL=sqlite:///./landdelay.db

# CORS Allowed Origins (comma-separated, without trailing slashes)
# Set to your Vercel URL in production:
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Administrative Key for /api/demo/reset and /api/demo/seed
ADMIN_RESET_KEY=landdelay-admin-secret-2026

# Whether to auto-seed on cold start when database is empty
AUTO_SEED_DEMO_DATA=true
